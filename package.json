{
	"name": "@muyianking/utils",
	"type": "module",
	"version": "0.1.3",
	"description": "通用工具函数库：通用判断与转换、DOM 与单位换算、文件处理、树结构转换、表单校验、颜色处理、localStorage 缓存与 ECharts 初始化",
	"keywords": [
		"utils",
		"typescript",
		"esm",
		"tree",
		"validator",
		"storage",
		"echarts"
	],
	"author": "MuyianKing",
	"license": "MIT",
	"homepage": "https://github.com/MuyianKing/utils#readme",
	"bugs": {
		"url": "https://github.com/MuyianKing/utils/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/MuyianKing/utils.git"
	},
	"module": "./index.js",
	"main": "./index.js",
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"scripts": {
		"pub": "node ./script/publish.js",
		"build": "node ./script/build.js",
		"dev": "rslib build --watch",
		"update-dep": "npm-check-updates && ncu -u && pnpm i",
		"commit": "git add . && git cz",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"husky-lint": "lint-staged",
		"prepare": "husky",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest --run",
		"test:watch": "vitest",
		"coverage": "vitest --run --coverage",
		"log": "node ./script/changelog.js"
	},
	"dependencies": {
		"@vueuse/core": "^14.3.0",
		"dayjs": "^1.11.21",
		"echarts": "^6.1.0",
		"lodash-es": "^4.18.1",
		"nanoid": "^5.1.11"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.0.0",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@eslint/eslintrc": "^3.3.5",
		"@rslib/core": "^0.22.0",
		"@types/js-cookie": "^3.0.6",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^25.9.2",
		"@vitest/coverage-v8": "^4.1.8",
		"conventional-changelog": "^8.1.3",
		"conventional-changelog-angular": "^9.4.0",
		"cz-git": "^1.13.1",
		"eslint": "10.4.1",
		"eslint-plugin-format": "^2.0.1",
		"fs-extra": "^11.3.5",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.7",
		"ora": "^9.4.0",
		"typescript": "^6.0.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.8"
	},
	"config": {
		"commitizen": {
			"path": "node_modules/cz-git"
		}
	},
	"lint-staged": {
		"*.{js,ts,vue}": [
			"eslint --fix"
		]
	}
}
